project    = "tamacoach"
env        = "dev"
owner      = "platform-team"
aws_region = "ap-northeast-2"
enable_irsa = false
enable_access_entries = true
enable_rbac           = true
enable_jump_host      = true

kubernetes_version = "1.30"
system_nodegroup_instance_types = ["t3.medium"]
system_nodegroup_min_size       = 2
system_nodegroup_max_size       = 4
system_nodegroup_desired_size   = 2
jump_host_instance_type         = "t3.small"
jump_host_install_helm          = false
jump_host_kubectl_version       = "1.30.0"

# Pass these from your EKS stack outputs when enable_irsa = true.
# cluster_name      = module.eks.cluster_name
# oidc_provider_arn = module.eks.oidc_provider_arn
# oidc_provider_url = module.eks.oidc_provider_url

# Keep empty if this stack does not create SSM parameters directly.
# ssm_parameter_names = [
#   "/tamacoach/dev/app/backend/db_url",
#   "/tamacoach/dev/sqs/worker-task/url",
# ]

# backend_queue_arns = ["arn:aws:sqs:ap-northeast-2:123456789012:tamacoach-dev-domain-purpose"]
# worker_queue_arns  = ["arn:aws:sqs:ap-northeast-2:123456789012:tamacoach-dev-domain-purpose"]
# lbc_policy_arns    = ["arn:aws:iam::123456789012:policy/AWSLoadBalancerControllerIAMPolicy"]
# karpenter_policy_arns = ["arn:aws:iam::123456789012:policy/KarpenterControllerPolicy-tamacoach-dev"]
# enable_adot_irsa = false
# adot_policy_arns = []
# enable_external_secrets_irsa = false
# external_secrets_policy_arns = []

