project    = "tamacoach"
env        = "dev"
owner      = "platform-team"
aws_region = "ap-northeast-2"
enable_irsa = false
enable_access_entries = true
enable_rbac           = true
enable_jump_host      = true

kubernetes_version = "1.30"
control_plane_log_types         = ["api", "audit", "authenticator", "controllerManager", "scheduler"]
control_plane_log_retention_days = 14
enable_fluent_bit               = true
enable_adot_metrics             = false
enable_adot_irsa                = false
# eks_log_kms_key_arn           = "arn:aws:kms:ap-northeast-2:123456789012:key/xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
system_nodegroup_instance_types = ["t3.medium"]
system_nodegroup_min_size       = 2
system_nodegroup_max_size       = 4
system_nodegroup_desired_size   = 2
jump_host_instance_type         = "t3.small"
jump_host_install_helm          = false
jump_host_kubectl_version       = "1.30.0"

# Pass these from your EKS stack outputs when enable_irsa = true.
# cluster_name      = module.eks.cluster_name
# oidc_provider_arn = module.eks.oidc_provider_arn
# oidc_provider_url = module.eks.oidc_provider_url

# Keep empty if this stack does not create SSM parameters directly.
# ssm_parameter_names = [
#   "/tamacoach/dev/app/backend/db_url",
#   "/tamacoach/dev/sqs/worker-task/url",
# ]

# backend_queue_arns = ["arn:aws:sqs:ap-northeast-2:123456789012:tamacoach-dev-domain-purpose"]
# worker_queue_arns  = ["arn:aws:sqs:ap-northeast-2:123456789012:tamacoach-dev-domain-purpose"]
# lbc_policy_arns / karpenter_policy_arns are optional overrides.
# By default, Terraform creates and uses:
# - AWSLoadBalancerControllerIAMPolicy-${project}-${env}
# - KarpenterControllerPolicy-${project}-${env}
# karpenter_node_role_arn = "arn:aws:iam::123456789012:role/karpenter-node-role-dev"
# karpenter_interruption_queue_arn = "arn:aws:sqs:ap-northeast-2:123456789012:karpenter-interruption-dev"
# adot_remote_write_endpoint = "https://aps-workspaces.ap-northeast-2.amazonaws.com/workspaces/ws-xxxx/api/v1/remote_write"
# adot_scrape_interval       = "30s"
# adot_scrape_timeout        = "10s"
# adot_metric_drop_labels    = ["pod_uid", "container_id", "id"]
# adot_policy_arns           = [] # optional override (defaults to shared output)
# enable_external_secrets_irsa = false
# external_secrets_policy_arns = []

# access_entries = [
#   {
#     principal_arn = "arn:aws:iam::123456789012:role/tamacoach-platform-admin"
#     groups        = ["tama:platform-admin"]
#   },
#   {
#     principal_arn = "arn:aws:iam::123456789012:role/tamacoach-platform-ops"
#     groups        = ["tama:platform-ops"]
#   },
#   {
#     principal_arn = "arn:aws:iam::123456789012:role/tamacoach-developer"
#     groups        = ["tama:developer"]
#   },
#   {
#     principal_arn = "arn:aws:iam::123456789012:role/tamacoach-argocd-deployer"
#     groups        = ["tama:argocd-deployer"]
#   },
# ]
#
